language = en

# Use zsh
command = /usr/bin/zsh

# Automatically inject Zsh shell integration
# - ssh-terminfo copies Ghostty's terminfo to ~/.terminfo on SSH hosts (ssh-env falls back to
#   xterm-256color if that fails). Root can't see ~/.terminfo, so on hosts where you use sudo,
#   run `ghostty-terminfo HOST` once to install it system-wide
shell-integration = zsh
shell-integration-features = sudo,ssh-terminfo,ssh-env

theme = "Dracula"
window-theme = dark
window-decoration = client
window-vsync = true

# Fonts
font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-thicken = true

mouse-hide-while-typing = true

app-notifications = no-clipboard-copy

