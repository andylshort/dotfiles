language = en

# Use zsh
command = /usr/bin/zsh

# Automatically inject Zsh shell integration
# - ssh-env: SSH sessions get TERM=xterm-256color, which every host (and sudo) understands,
#   instead of trying to install Ghostty's terminfo on each host first
shell-integration = zsh
shell-integration-features = ssh-env

theme = "Catppuccin Macchiato"
window-theme = dark
window-decoration = client
window-vsync = true

# Fonts
font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-thicken = true

# Disable programming ligatures (>= -> != etc.) so each character is its own cell
# JetBrainsMono Nerd Font already has code ligatures, so these interfere
font-feature = -calt
font-feature = -liga
font-feature = -dlig

mouse-hide-while-typing = true

app-notifications = no-clipboard-copy


# Tabs and splits are tmux's job: hand Ghostty's keys for them (and fullscreen) to the
# programs inside instead
keybind = ctrl+enter=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+page_up=unbind
keybind = ctrl+page_down=unbind
keybind = ctrl+alt+arrow_up=unbind
keybind = ctrl+alt+arrow_down=unbind
keybind = ctrl+alt+arrow_left=unbind
keybind = ctrl+alt+arrow_right=unbind
keybind = alt+1=unbind
keybind = alt+digit_1=unbind
keybind = alt+2=unbind
keybind = alt+digit_2=unbind
keybind = alt+3=unbind
keybind = alt+digit_3=unbind
keybind = alt+4=unbind
keybind = alt+digit_4=unbind
keybind = alt+5=unbind
keybind = alt+digit_5=unbind
keybind = alt+6=unbind
keybind = alt+digit_6=unbind
keybind = alt+7=unbind
keybind = alt+digit_7=unbind
keybind = alt+8=unbind
keybind = alt+digit_8=unbind
keybind = alt+9=unbind
keybind = alt+digit_9=unbind
