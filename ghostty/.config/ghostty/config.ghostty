language = en

# Use zsh
command = /usr/bin/zsh

# Automatically inject Zsh shell integration
# - ssh-env: SSH sessions get TERM=xterm-256color, which every host (and sudo) understands,
#   instead of trying to install Ghostty's terminfo on each host first
shell-integration = zsh
shell-integration-features = ssh-env

theme = "Dracula"
window-theme = dark
window-decoration = client
window-vsync = true

# Fonts
font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-thicken = true

mouse-hide-while-typing = true

app-notifications = no-clipboard-copy

