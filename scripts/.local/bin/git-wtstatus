#!/usr/bin/env bash
# git-wtstatus — summarise every worktree of the current repo: what needs pushing, pulling or
# rebasing, and whether it has uncommitted changes.
#
# Usage:
#   git wtstatus [-n|--no-fetch] [<base>]
#
# <base> is the ref each branch is compared against (default: origin/master if it exists,
# else origin/HEAD).
#
# Columns: "up +A/-B" is A commits to push and B to pull vs the branch's upstream;
#          "base +A/-B" is A commits ahead of and B behind <base>; "dirty" counts changed files.

set -o errexit -o nounset -o pipefail

die() {
    printf '%s: %s\n' "${0##*/}" "$*" >&2
    exit 1
}

fetch=1
base=
for arg in "$@"; do
    case $arg in
        -n | --no-fetch) fetch=0 ;;
        -h | --help)
            sed -n '2,/^$/{s/^# \{0,1\}//p}' "$0"
            exit 0
            ;;
        -*) die "unknown option: $arg" ;;
        *) base=$arg ;;
    esac
done

git rev-parse --git-dir > /dev/null 2>&1 || die "not in a git repository"

if ((fetch)); then
    git fetch -q --all --prune || printf '%s: fetch failed; using last fetch\n' "${0##*/}" >&2
fi

if [[ -z $base ]]; then
    if git rev-parse -q --verify origin/master > /dev/null; then
        base=origin/master
    else
        base=origin/HEAD
    fi
fi
git rev-parse -q --verify "$base" > /dev/null || die "no such ref: $base"

# Print "+<ahead>/-<behind>" of HEAD relative to $2, in worktree $1
counts() {
    git -C "$1" rev-list --left-right --count "$2...HEAD" | awk '{print "+" $2 "/-" $1}'
}

printf 'base: %s\n' "$base"
printf '%-32s %-14s %-14s %s\n' BRANCH UP BASE DIRTY
git worktree list --porcelain | awk '/^worktree /{print substr($0, 10)}' |
    while IFS= read -r wt; do
        branch=$(git -C "$wt" branch --show-current)
        [[ -n $branch ]] || branch="(detached $(git -C "$wt" rev-parse --short HEAD))"
        if git -C "$wt" rev-parse -q --verify '@{u}' > /dev/null 2>&1; then
            up=$(counts "$wt" '@{u}')
        else
            up=no-upstream
        fi
        dirty=$(git -C "$wt" status --porcelain | wc -l)
        printf '%-32s %-14s %-14s %s\n' "$branch" "$up" "$(counts "$wt" "$base")" "$dirty"
    done
