#compdef git-delete-branch
# Completion for the delete-branch git alias. Defining _git-delete-branch stops _git from
# expanding the (shell) alias itself, and its dispatch then hands `git delete-branch` here.
#
# Offers local branches, most recent first, skipping any already on the command line.

_git-delete-branch() {
    local -a branchrefs expl
    branchrefs=(${(f)"$(git for-each-ref --sort=-committerdate \
        --format='%(refname:short)' refs/heads 2>/dev/null)"})

    # Drop branches already given as earlier arguments.
    branchrefs=(${branchrefs:|words})

    _wanted heads expl branch compadd -V branches -a branchrefs
}

_git-delete-branch "$@"
