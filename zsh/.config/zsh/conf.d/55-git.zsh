# ${XDG_CONFIG_HOME}/zsh/conf.d/55-git.zsh

# Aliases
alias gs='git status'

alias gd='git diff'

alias ga='git add'
alias gau='git add -u'

alias gc='git commit'

alias gp='git push'

alias gfo='git fetch origin'

alias grb='git rebase'
alias grbm='git rebase origin/master'

alias gco='git checkout'
alias gsw='git switch'