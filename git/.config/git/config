[core]
    # Fall back to less (git's default) if delta isn't installed
    pager = "if command -v delta >/dev/null 2>&1; then exec delta; else exec less; fi"

[init]
	defaultBranch = main

[interactive]
    # diffFilter must preserve lines 1:1, so fall back to passing the diff through untouched
    diffFilter = "if command -v delta >/dev/null 2>&1; then exec delta --color-only; else exec cat; fi"

[delta]
    navigate = true
    dark = true

[commit]
	verbose = true

[color]
	ui = auto

[column]
	ui = auto

[pull]
	rebase = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = patience
	colorMoved = true
	noprefix = true
	renames = copy
	renameLimit = 999999

[status]
	submoduleSummary = true

[submodule]
	# Fetch submodules in five threads
    fetchJobs = 5

	# Doesn't affect clone. Means 'git pull' and others
	# will recurse into the submodules
	recurse = true

[stash]
	showPatch = true

[pack]
	# Use all cores when packing
	threads = 0

[help]
	# Autocorrect on a slight typo
	autocorrect = -1


[user]
	name = Andrew Lamzed-Short

[pager]
	branch = false

[alias]
    latest-branches = "branch --sort=-committerdate --format='%(align:18,left)%(committerdate:relative)%(end)%(align:20,left)%(authorname)%(end)%(refname:short)'"
    lg = "log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
    # Delete branches locally and on origin. Each side of each branch is
    # handled on its own: missing ones are skipped, and one failure doesn't
    # stop the rest. Exits non-zero if any delete actually failed.
    delete-branch = "!f() { \
        rc=0; \
        for b in \"$@\"; do \
            if git show-ref -q --verify \"refs/heads/$b\"; then \
                git branch -D \"$b\" || rc=1; \
            else \
                echo \"local: $b not found, skipping\"; \
            fi; \
            git ls-remote -q --exit-code origin \"refs/heads/$b\" >/dev/null; \
            case $? in \
                0) git push origin --delete \"$b\" || rc=1 ;; \
                2) echo \"origin: $b not found, skipping\"; \
                   git branch -q -dr \"origin/$b\" 2>/dev/null ;; \
                *) echo \"origin: can't check $b\" >&2; rc=1 ;; \
            esac; \
        done; \
        return $rc; \
    }; f"
    up = !git fetch --no-recurse-submodules origin && git rebase origin/HEAD && git submodule sync --recursive && git submodule update --init --recursive

[include]
	path = ~/.gitconfig.personal
	path = ~/.gitconfig.work
