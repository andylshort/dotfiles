[core]
	# Automatically resolve linux-to-windows issues
	autocrlf = false
	trustctime = false

	# Detect identation when tabs instead of spaces
	whitespace = blank-at-eol,space-before-tab,tab-in-indent,trailing-space

    # Fall back to less (git's default) if delta isn't installed
    pager = "if command -v delta >/dev/null 2>&1; then exec delta; else exec less; fi"

[init]
	defaultBranch = main

[interactive]
    # diffFilter must preserve lines 1:1, so fall back to passing the diff through untouched
    diffFilter = "if command -v delta >/dev/null 2>&1; then exec delta --color-only; else exec cat; fi"

[delta]
    navigate = true
    dark = true

[commit]
	verbose = true

[color]
	ui = auto

[column]
	ui = auto

[pull]
	rebase = true

[merge]
	renormalize = true
	conflictstyle = zdiff3

[diff]
	algorithm = patience
	colorMoved = true
	noprefix = true
	renames = copy
	renameLimit = 999999

[status]
	submoduleSummary = true

[submodule]
	# Fetch submodules in five threads
    fetchJobs = 5

	# Doesn't affect clone. Means 'git pull' and others
	# will recurse into the submodules
	recurse = true

[stash]
	showPatch = true

[pack]
	# Use all cores when packing
	threads = 0

[help]
	# Autocorrect on a slight typo
	autocorrect = -1


[user]
	name = Andrew Lamzed-Short

[pager]
	branch = false

[alias]
    latest-branches = "branch --sort=-committerdate --format='%(align:18,left)%(committerdate:relative)%(end)%(align:20,left)%(authorname)%(end)%(refname:short)'"
    lg = "log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
    delete-branch = "!f() { git branch -D \"$@\"; git push origin --delete \"$@\"; }; f"
    up = !git fetch --no-recurse-submodules origin && git rebase origin/HEAD && git submodule sync --recursive && git submodule update --init --recursive

[include]
	path = ~/.gitconfig.personal
	path = ~/.gitconfig.work
